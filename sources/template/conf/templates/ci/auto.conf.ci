##
## Extensions for CI (build_all / build without network access)
##

# Allow automatic building with meta-freescale / meta-ti / meta-qt6
ACCEPT_FSL_EULA = "y"
ACCEPT_NXP_EULA = "y"
ACCEPT_TI_EULA = "y"
ACCEPT_QT6_EULA = "y"

# restrict network access
BB_NO_NETWORK = "1"
BB_FETCH_PREMIRRORONLY = "1"

# generate source and license dir for deployment:
INHERIT += "archiver"
# include all packages in archive, that are not covered by COPYLEFT_LICENSE_EXCLUDE
COPYLEFT_LICENSE_INCLUDE = "*"
# contains "CLOSED Proprietary" per default
COPYLEFT_LICENSE_EXCLUDE += "\
    CLOSED \
    NXP-Binary-EULA \
    Proprietary \
    TI-TFL \
    TI-TSPA \
"

ARCHIVER_MIRROR_EXCLUDE = "file://"

# Source packages for package mirror
BB_GENERATE_MIRROR_TARBALLS = "1"
ARCHIVER_MODE[src] ?= "mirror"
ARCHIVER_MODE[mirror] = "combined"

# disable SPDX generation for merge request speedup
# shall be enabled for release builds
INHERIT:remove = "create-spdx"

# pin CycloneDX format version and set per-machine output path
CYCLONEDX_SPEC_VERSION = "1.6"
CYCLONEDX_EXPORT_DIR   = "${DEPLOY_DIR}/images/${MACHINE}"
CYCLONEDX_EXPORT_SBOM  = "${CYCLONEDX_EXPORT_DIR}/${MACHINE}-${PN}.bom.json"
CYCLONEDX_EXPORT_VEX   = "${CYCLONEDX_EXPORT_DIR}/${MACHINE}-${PN}.vex.json"
