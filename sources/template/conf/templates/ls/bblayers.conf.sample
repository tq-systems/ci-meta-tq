POKY_BBLAYERS_CONF_VERSION = "2"

BBPATH = "${TOPDIR}"
BSPDIR := "${@os.path.abspath(os.path.dirname(d.getVar('FILE', True)) + '/../..')}"

BBFILES ?= ""
BBLAYERS += "${BSPDIR}/sources/openembedded-core/meta"
BBLAYERS += "${BSPDIR}/sources/meta-yocto/meta-poky"
BBLAYERS += "${BSPDIR}/sources/meta-openembedded/meta-oe"
BBLAYERS += "${BSPDIR}/sources/meta-openembedded/meta-python"
BBLAYERS += "${BSPDIR}/sources/meta-openembedded/meta-networking"
BBLAYERS += "${BSPDIR}/sources/meta-freescale"
BBLAYERS += "${BSPDIR}/sources/meta-tq/meta-tq"
BBLAYERS += "${BSPDIR}/sources/meta-tq/meta-dumpling"
